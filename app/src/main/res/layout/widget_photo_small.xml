<?xml version="1.0" encoding="utf-8"?>
<!--
  media, small: one picture filling the widget with a one-line label. One tap target.
  Lint: clipToOutline rounds picture corners from API 31 and is ignored below it, as intended;
  where nested weights are allowed, they are the grid itself.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    tools:ignore="UnusedAttribute"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_cd_picture"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_tile_placeholder" />
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_scrim"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:textColor="@color/widget_on_photo"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/widget_badge_background"
        android:importantForAccessibility="no"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="@string/widget_video_badge"
        android:textColor="@color/widget_on_photo"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
