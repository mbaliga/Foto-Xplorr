<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      dev.aarso:hyle declares minSdk=31 (see hyle-design-system/hyle/build.gradle.kts);
      this app's own minSdk stays 26 (unchanged: lowering device support was out of
      scope for this change). tools:overrideLibrary is the standard AGP manifest-merger
      escape hatch for "I know a dependency asks for a higher minSdk than the app
      declares, keep the app's own minSdk/targetSdk". This has NOT been verified against
      an actual API 26 to 30 device/emulator in this environment (no Android SDK
      available): it only suppresses the manifest-merger error. If :hyle's Compose
      Modifiers/AGSL shaders (still unreleased per its own README) end up calling any
      API gated above 26, that would need to be caught by lint/testing on a real device
      or emulator running API below 31, which this change could not do.
    -->
    <uses-sdk tools:overrideLibrary="dev.aarso.hyle" />

    <!--
      Lets the background work job survive a reboot (JobInfo.setPersisted, in
      BackgroundScheduler). Declared for this and nothing else: the app registers no
      BOOT_COMPLETED receiver and runs no code at boot. It grants no network access and is not
      one of the permissions verifyOfflineManifest forbids, so it is safe in both flavours.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- No network permissions here. INTERNET lives in src/connect/AndroidManifest.xml:
         the offline flavor is the app's local-first identity, and the verifyOfflineManifest
         gate fails the build if any network permission reaches its merged manifest — from
         this file OR from a library AAR's manifest. ACCESS_NETWORK_STATE was dropped
         entirely: nothing in the app reads ConnectivityManager. -->
    <!-- Current location is optional and used only by the explicitly opened relative
         spatial-compass scene. ACCESS_MEDIA_LOCATION is separate: Android 10+ redacts
         GPS embedded in the user's media unless it is granted. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Android 13+'s own audio-library permission; without it the Audio destination sees
         nothing at all on API 33+, since READ_MEDIA_IMAGES/VIDEO do not cover audio rows. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- MediaStore writes (trash/restore/rename/metadata/overwrite, and every insert this app
         makes for a conversion or an edited copy) need this below API 29, which replaced it
         with scoped storage and per-file consent, which is why it stops at 28. Without this an
         Android 8-9 device fails every one of those writes with no explanation. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- The job-progress and (agent B's) playback notifications, required from Android 13
         onward or the system silently drops them with no error. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- JobForegroundService's own manifest declaration, below, plus the two service types it
         switches between depending on API level; see that class's own doc. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Agent B's PlaybackService (audio/**) needs both of these; declared here rather than left
         for that change because a missing permission fails at the manifest-merger/runtime level
         in a way that is easy to miss if the service and its permissions land in two different
         reviews. Only the <service> element itself is agent B's to add. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!--
      Package visibility for the text hand-offs (Android 11+).

      Intent.resolveActivity() and queryIntentActivities() return nothing for packages the app
      cannot see, and since API 30 an app sees almost nothing by default. Without this block the
      "Translate with..." hand-off would report NO translator installed on a phone that has
      several, and would silently fall back to the generic share sheet, a failure that looks
      like the feature is broken rather than like a manifest omission.

      Declares only the two intents actually used, not QUERY_ALL_PACKAGES: the broad permission is
      a Play policy problem and gives this app far more visibility than reading text needs.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".FotoXplorrApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Foto Xplorr"
        android:supportsRtl="true"
        android:theme="@style/Theme.FotoXplorr">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          The job the background work rules schedule. Declared for both flavours: the idle,
          quiet-hours, charging and battery rules are all meaningful with no network at all, and
          the one connect-only rule (Wi-Fi) is gated in code rather than here.

          BIND_JOB_SERVICE is declared ON the service to restrict binding to the system, which is
          the only holder of that permission. It is standard JobService boilerplate, not a
          permission this app requests for itself, so it adds nothing to the offline flavour's
          permission set and the verifyOfflineManifest gate is unaffected.
        -->
        <service
            android:name="com.fotoxplorr.app.background.BackgroundWorkJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Keeps a conversion/export/copy-move job visible (and cancellable) while the app is
             not in the foreground. Both types are declared; JobForegroundService picks
             mediaProcessing on API 35+ and falls back to dataSync below that, at startForeground
             call time; see that class's own doc for why a manifest declaration cannot itself be
             conditional on API level. -->
        <service
            android:name="com.fotoxplorr.app.jobs.JobForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <activity
            android:name=".FotoXplorrActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Open-with target: viewing/editing/receiving media handed over by another app.
              android:mimeType alone (with no scheme/host) matches BOTH content:// and file://
              Uris carrying that type, which is what lets this filter answer ACTION_VIEW and
              ACTION_SEND from a file manager (file://) as well as from a modern share sheet
              (content://) with one <data> element rather than two nearly-identical ones.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
