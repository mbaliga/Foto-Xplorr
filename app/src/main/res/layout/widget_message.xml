<?xml version="1.0" encoding="utf-8"?>
<!--
  Every non-content state: no photo access, nothing to show, could not load. The whole widget opens the app.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    android:gravity="center_vertical">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="5"
        android:textColor="@color/widget_on_surface_muted"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="@string/widget_open_app_action"
        android:layout_marginTop="6dp" />
</LinearLayout>
