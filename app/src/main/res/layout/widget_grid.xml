<?xml version="1.0" encoding="utf-8"?>
<!--
  media, medium and large: a header over one row of four tiles (medium) or two (large). Unused tiles are hidden.
  Lint: clipToOutline rounds picture corners from API 31 and is ignored below it, as intended;
  where nested weights are allowed, they are the grid itself.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    tools:ignore="UnusedAttribute,NestedWeights"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/widget_slot0_frame"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/widget_tile_gap"
            android:background="@drawable/widget_tile_background"
            android:clipToOutline="true">
            <ImageView
                android:id="@+id/widget_slot0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_cd_picture"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_tile_placeholder" />
            <TextView
                android:id="@+id/widget_slot0_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/widget_scrim"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="16dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:textColor="@color/widget_on_photo"
                android:textSize="12sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_slot0_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/widget_badge_background"
                android:importantForAccessibility="no"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/widget_video_badge"
                android:textColor="@color/widget_on_photo"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
