<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 26, exactly the API adaptive icons were introduced in. Every supported
  device reads this file, so there is no legacy ic_launcher.png fallback
  anywhere in the mipmap folders. Both layers are vectors: the background is a plain
  colour (white, or black in values-night) and the foreground's top panel flips the
  other way, so the light and dark icons are one drawing. The monochrome layer is the
  Android 13+ themed icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
