<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      dev.aarso:hyle declares minSdk=31 (see hyle-design-system/hyle/build.gradle.kts);
      this app's own minSdk stays 26 (unchanged: lowering device support was out of
      scope for this change). tools:overrideLibrary is the standard AGP manifest-merger
      escape hatch for "I know a dependency asks for a higher minSdk than the app
      declares, keep the app's own minSdk/targetSdk". This has NOT been verified against
      an actual API 26 to 30 device/emulator in this environment (no Android SDK
      available): it only suppresses the manifest-merger error. If :hyle's Compose
      Modifiers/AGSL shaders (still unreleased per its own README) end up calling any
      API gated above 26, that would need to be caught by lint/testing on a real device
      or emulator running API below 31, which this change could not do.

      androidx.heifwriter declares minSdk=28 (its whole surface is a thin wrapper over the
      MediaCodec HEIC encoder, which does not exist before API 28) for the same "keep the
      app's own floor" reason: HEIC export itself is gated at the call site on
      Build.VERSION.SDK_INT >= 28 AND a real HEVC encoder being present (see
      isHeicExportSupported), so no code path below API 28 can reach it regardless of what
      the manifest merger would otherwise refuse to build.
    -->
    <uses-sdk tools:overrideLibrary="dev.aarso.hyle,androidx.heifwriter" />

    <!--
      Lets the background work job survive a reboot (JobInfo.setPersisted, in
      BackgroundScheduler). Declared for this and nothing else: the app registers no
      BOOT_COMPLETED receiver and runs no code at boot. It grants no network access and is not
      one of the permissions verifyOfflineManifest forbids, so it is safe in both flavours.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- No network permissions here. INTERNET lives in src/connect/AndroidManifest.xml:
         the offline flavor is the app's local-first identity, and the verifyOfflineManifest
         gate fails the build if any network permission reaches its merged manifest — from
         this file OR from a library AAR's manifest. ACCESS_NETWORK_STATE was dropped
         entirely: nothing in the app reads ConnectivityManager. -->
    <!-- Current location is optional and used only by the explicitly opened relative
         spatial-compass scene. ACCESS_MEDIA_LOCATION is separate: Android 10+ redacts
         GPS embedded in the user's media unless it is granted. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Requested separately from the three above, only when the user opens the Audio library
         (P0-10): granting it must never count as "media access granted" for the photo/video
         gallery, and asking for it up front would show a permission the photo/video flow does
         not need. Below API 33, READ_EXTERNAL_STORAGE already covers MediaStore.Audio queries.
         Android 13+'s own audio-library permission; without it the Audio destination sees
         nothing at all on API 33+, since READ_MEDIA_IMAGES/VIDEO do not cover audio rows. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- MediaStore writes (trash/restore/rename/metadata/overwrite, and every insert this app
         makes for a conversion or an edited copy) need this below API 29, which replaced it
         with scoped storage and per-file consent, which is why it stops at 28. Without this an
         Android 8-9 device fails every one of those writes with no explanation. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- The job-progress and (agent B's) playback notifications, required from Android 13
         onward or the system silently drops them with no error. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- JobForegroundService's own manifest declaration, below, plus the two service types it
         switches between depending on API level; see that class's own doc. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Agent B's PlaybackService (audio/**) needs both of these; declared here rather than left
         for that change because a missing permission fails at the manifest-merger/runtime level
         in a way that is easy to miss if the service and its permissions land in two different
         reviews. Only the <service> element itself is agent B's to add. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!--
      Package visibility for the text hand-offs (Android 11+).

      Intent.resolveActivity() and queryIntentActivities() return nothing for packages the app
      cannot see, and since API 30 an app sees almost nothing by default. Without this block the
      "Translate with..." hand-off would report NO translator installed on a phone that has
      several, and would silently fall back to the generic share sheet, a failure that looks
      like the feature is broken rather than like a manifest omission.

      Declares only the two intents actually used, not QUERY_ALL_PACKAGES: the broad permission is
      a Play policy problem and gives this app far more visibility than reading text needs.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".FotoXplorrApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FotoXplorr">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          The job the background work rules schedule. Declared for both flavours: the idle,
          quiet-hours, charging and battery rules are all meaningful with no network at all, and
          the one connect-only rule (Wi-Fi) is gated in code rather than here.

          BIND_JOB_SERVICE is declared ON the service to restrict binding to the system, which is
          the only holder of that permission. It is standard JobService boilerplate, not a
          permission this app requests for itself, so it adds nothing to the offline flavour's
          permission set and the verifyOfflineManifest gate is unaffected.
        -->
        <service
            android:name="com.fotoxplorr.app.background.BackgroundWorkJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!--
          Background audio playback (androidx.media3.session.MediaSessionService). exported=true
          and the MediaSessionService intent-filter are both required for a MediaController in
          another process (Android Auto, the system media notification, an assistant) to bind to
          this session at all: a MediaSessionService the system cannot see is indistinguishable
          from having no session. This is the service element only: FOREGROUND_SERVICE,
          FOREGROUND_SERVICE_MEDIA_PLAYBACK, POST_NOTIFICATIONS, WAKE_LOCK and READ_MEDIA_AUDIO
          are declared elsewhere (see docs/audio-playback.md for exactly which and when).
        -->
        <service
            android:name="com.fotoxplorr.app.playback.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Keeps a conversion/export/copy-move job visible (and cancellable) while the app is
             not in the foreground. Both types are declared; JobForegroundService picks
             mediaProcessing on API 35+ and falls back to dataSync below that, at startForeground
             call time; see that class's own doc for why a manifest declaration cannot itself be
             conditional on API level. -->
        <service
            android:name="com.fotoxplorr.app.jobs.JobForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <activity
            android:name=".FotoXplorrActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <!-- P0-09: Compose reacts to every one of these through LocalConfiguration without
                 needing the Activity recreated: confirmed no values-night/values-land/locale-
                 qualified resource directories exist in res/ (only density-qualified mipmaps,
                 resolved per request regardless of recreation) and onCreate() itself reads no
                 resource directly outside setContent {}. This covers rotation, folding, external
                 keyboards/hubs and desktop mode; it does NOT cover process death, which
                 FotoXplorrActivity.kt's own rememberSaveable viewer/editor state (P0-09 item 6)
                 handles separately. singleTop + supportsPictureInPicture come from the media3
                 viewer work (onNewIntent for open-with / share-to, and in-app video PiP). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Receive-only targets: media handed over for editing (EDIT) or shared in (SEND).
              There is deliberately NO VIEW filter here: ExternalViewerActivity is the single
              VIEW target (content:// only), so another app's chooser lists this app once, not
              twice, and nothing reaches the viewer by a path that skips its checks. The SEND
              filter carries no scheme because a share names its Uri in EXTRA_STREAM, not in the
              intent data; classifyIncomingIntent therefore enforces content:// itself.
            -->
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!--
          "Open with" (P0-18): the single VIEW target (FotoXplorrActivity only receives EDIT and
          SEND). A photo or video tapped in another app — the Files app, including on a USB drive —
          reaches this, since it needs no gallery, no permission grant beyond what the incoming
          content:// URI already carries, and never touches this app's own catalogue. Every <data>
          here names scheme="content": a file:// Uri would have this app read any path it can.
          Same configChanges as FotoXplorrActivity, per P0-09, and for the identical reason: every
          value here is one Compose already reacts to on its own. supportsPictureInPicture because
          the video player offers PiP wherever it is hosted (and arms auto-enter while playing);
          without it the button did nothing here and auto-enter was silently ignored.
        -->
        <activity
            android:name=".viewer.ExternalViewerActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="image/*" />
                <data android:scheme="content" android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!--
          Photo picker (P0-20, stretch): lets another app pick photos or videos from this
          library via the standard ACTION_GET_CONTENT or the older ACTION_PICK, in a read-only
          selection grid over the same browsableAssets(...) filter (P0-01) every other screen in
          this app already uses — nothing locked or hidden is ever offered to the caller. Same
          shape as "Open with" (P0-18): a focused activity of its own, never FotoXplorrActivity
          with a mode flag, and the same configChanges as every other activity here, per P0-09.
        -->
        <activity
            android:name=".picker.PhotoPickerActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
