<?xml version="1.0" encoding="utf-8"?>
<!--
  list, medium and large: up to three or five rows, each a cover, the months it spans and a count. Unused
  rows are hidden. Rows are at least 52dp and grow with large font sizes rather than cutting their
  second line.
  Lint: clipToOutline rounds picture corners from API 31 and is ignored below it, as intended;
  where nested weights are allowed, they are the grid itself.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    tools:ignore="UnusedAttribute"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="12sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/widget_row0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_tile_background"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/widget_row0_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_cd_picture"
                    android:scaleType="centerCrop"
                    android:src="@drawable/widget_tile_placeholder" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/widget_row0_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/widget_row0_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_tile_background"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/widget_row1_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_cd_picture"
                    android:scaleType="centerCrop"
                    android:src="@drawable/widget_tile_placeholder" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/widget_row1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/widget_row1_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_tile_background"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/widget_row2_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_cd_picture"
                    android:scaleType="centerCrop"
                    android:src="@drawable/widget_tile_placeholder" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/widget_row2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/widget_row2_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_tile_background"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/widget_row3_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_cd_picture"
                    android:scaleType="centerCrop"
                    android:src="@drawable/widget_tile_placeholder" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/widget_row3_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/widget_row3_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/widget_tile_background"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/widget_row4_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_cd_picture"
                    android:scaleType="centerCrop"
                    android:src="@drawable/widget_tile_placeholder" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/widget_row4_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/widget_row4_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
